# Cloudflare Workers static-assets header rules (copied into public/ by Hugo).
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Security baseline for every response. A Content-Security-Policy is
# deliberately NOT set here yet, but the reason is narrower than it used to
# be. The build carries ZERO inline <script> blocks and zero inline event
# handlers (the only inline scripts are `application/ld+json` data blocks),
# so `script-src 'self'` needs no allowlist and no nonce. What still blocks
# a clean policy:
#
#   - inline `style=` attributes on every page (KaTeX sizing plus the
#     vendored theme's search partial) require `style-src 'unsafe-inline'`;
#   - Pagefind runs WebAssembly in a worker -> `'wasm-unsafe-eval'` and
#     `worker-src 'self'`;
#   - MathLive's read-aloud builds audio as a blob URL -> `media-src blob:`,
#     and that is an accessibility feature, so it must not be broken.
#
# `'unsafe-eval'` is NOT required: the compute engine ships a `new Function`
# codegen path, but grading never reaches it (verified by trapping the
# Function constructor across a spread of representative answers).
# Roll any policy out as Content-Security-Policy-Report-Only first.
#
# NOTE: forcing http:// -> https:// cannot be done from this file. Enable
# "Always Use HTTPS" (and then HSTS) on the Cloudflare zone; the
# Strict-Transport-Security header below only takes effect on HTTPS
# responses, so it is safe to ship ahead of that toggle.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

# Content-hashed bundles: the URL changes when the content does, so browsers
# may cache them forever. HTML stays on the default short-lived policy.
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/compiled/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored KaTeX CSS/fonts are version-pinned but NOT content-hashed (their
# URLs would not change on a deliberate KaTeX upgrade), so they get a day,
# not a year.
/katex/*
  Cache-Control: public, max-age=86400

# Vendored textbook figures (static/media/<book>/*.webp) carry the source
# file's stem, not a content hash, so they get a day like the KaTeX assets —
# never `immutable`, which audit-build couples to hashed names.
/media/*
  Cache-Control: public, max-age=86400
